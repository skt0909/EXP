# Copy to .env in the project root and fill in real values. .env is
# gitignored and never committed; this file is the template that is.
#
# Every variable below is read via a walk-up-to-the-nearest-.env helper
# (Shared/db_utils.py, Worker/celery_app.py, Data/auth.py,
# Context_assembler/main.py) that RAISES if the variable is unset --
# none of them silently fall back to a hardcoded default. That is
# deliberate: a misconfigured environment should fail loudly at startup,
# not connect somewhere unintended (or, for ALLOWED_ORIGINS, accept
# requests from anywhere).

# Postgres connection string for the app itself (uvicorn, Celery worker,
# Celery Beat). See backend/Tests/README.md for the separate
# TEST_DATABASE_URL used only by the pytest suite (its own .env.test).
DATABASE_URL=postgresql://user:password@host:port/dbname

# Celery broker AND result backend, one URL for both (see
# backend/Worker/celery_app.py). Only needed for the worker, Beat, and
# anything that queues a task -- plain uvicorn without any Dream11/
# scheduled-task activity doesn't touch it.
REDIS_URL=redis://localhost:6379/0

# CORS allowlist for the FastAPI app (backend/Context_assembler/main.py),
# comma-separated for multiple origins, e.g.
#   ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# http://localhost:5173 is Vite's default dev-server origin (`npm run dev`
# under frontend/, confirmed by actually starting it). In production this
# must be the real deployed frontend origin(s) -- never a wildcard: this
# API carries a bearer token on every authenticated request.
ALLOWED_ORIGINS=http://localhost:5173

# Signs and verifies the JWT issued by POST /auth/login and /auth/register
# (backend/Data/auth.py). Any long random string; there is no dev default
# on purpose, so a forgotten JWT_SECRET fails at startup rather than
# signing tokens with a guessable constant.
JWT_SECRET=change-me-to-a-long-random-string

# Groq API key for /chat's LLM call (backend/Context_assembler/groq_client.py).
# Only needed to exercise /chat -- the rest of the app runs without it.
GROQ_API_KEY=your-groq-api-key-here

# API-Football key, used only by the (currently investigation-stage)
# Dream11 extended-stats work -- see ARCHITECTURE.md's Known Gaps. Not
# read by any code on the main request/worker paths yet.
API_FOOTBALL_DATA_KEY=your-api-football-key-here
